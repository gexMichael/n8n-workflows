        "operation": "executeQuery",
        "query": "SELECT \n    p.Category AS 商品分類,\n    SUM(od.Quantity) AS 總銷售數量,\n    SUM(od.Unit_Price * od.Quantity * (1 - od.Discount)) AS 分類總銷售額\nFROM Orders o\nJOIN `Order_Details` od ON o.id = od.Order_ID\nJOIN Products p ON od.Product_ID = p.id\nGROUP BY p.Category",

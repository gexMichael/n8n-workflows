        "jsCode": "const items = $input.all();\nlet reportText = \"📊 **本週競品價格趨勢報告**\\n\\n\";\n\nitems.forEach(item => {\n  reportText += `- ${item.json.store} (${item.json.product}): 平均 $${parseFloat(item.json.avg_price).toFixed(2)}\\n`;\n});\n\nreturn [{ json: { report: reportText } }];"

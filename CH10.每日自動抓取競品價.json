        "jsCode": "return [\n  {\n    \"store\": \"Moonshine Coffee Roasters\",\n    \"url\": \"https://moonshinecoffeeroasters.com/products/巴拿馬-los-cenizos-lot-175-藝妓-低溫日曬-panama-los-cenizos-lot-175-geisha-cold-fermentation-natural.json\"\n  },\n  {\n    \"store\": \"REC COFFEE\",\n    \"url\": \"https://rec-coffee.com/products/decaf-coffee-bag-pastry-gift.json\"\n  },\n  {\n    \"store\": \"Goodman Roaster\",\n    \"url\": \"https://goodmanroaster.tw/products/ethiopia-red-honey.json\"\n  }\n];"
      },

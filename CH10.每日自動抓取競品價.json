      "parameters": {
        "url": "={{ encodeURI($json.url) }}",
        "options": {}
      },
      "name": "Fetch Shopify JSON",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -3200,
        -16
      ],
      "id": "aa74667f-4886-4844-a682-4e715609378a"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const product = item.json.product;\n  \n  const productName = product.title;\n  const currentPrice = parseFloat(product.variants[0].price);\n\n  return {\n    json: {\n      store: product.vendor,\n      product: productName,\n      current_price: currentPrice\n    }\n  };\n});"
      },
      "name": "Extract Price",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2992,
        -16
      ],
      "id": "baa099cb-caa0-418f-bfc6-1338e02b85de"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  '{{ $json.store }}' as store,\n  '{{ $json.product }}' as product,\n  {{ $json.current_price }} as current_price,\n  (\n    SELECT price FROM competitor_prices \n    WHERE store = '{{ $json.store }}' AND product = '{{ $json.product }}' \n    AND date = CURDATE() - INTERVAL 1 DAY \n    LIMIT 1\n  ) as yesterday_price;",
        "options": {}
      },
      "name": "MariaDB: Get Yesterday",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.2,
      "position": [
        -2800,
        -16
      ],
      "id": "e50b3b9d-943f-4c60-95ed-2a301cbe0057",
      "credentials": {
        "mySql": {
          "id": "NwRL3dJ68F2mNQfe",
          "name": "MySQL account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const currentPrice = item.json.current_price;\n  const yesterdayPrice = item.json.yesterday_price || currentPrice;\n  \n  const diffAmount = currentPrice - yesterdayPrice;\n  const diffPercent = yesterdayPrice !== 0 ? (diffAmount / yesterdayPrice) * 100 : 0;\n  const isAlert = Math.abs(diffPercent) > 5;\n  \n  results.push({\n    json: {\n      store: item.json.store,\n      product: item.json.product,\n      current_price: currentPrice,\n      yesterday_price: yesterdayPrice,\n      diff_amount: diffAmount,\n      diff_percent: parseFloat(diffPercent.toFixed(2)),\n      is_alert: isAlert\n    }\n  });\n}\nreturn results;"
      },
      "name": "Calculate Fluctuation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2592,
        -16
      ],
      "id": "6e5ff714-8d61-4a9a-9946-d336eb08347c"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO competitor_prices (store, product, price, date) \nVALUES ('{{ $json.store }}', '{{ $json.product }}', {{ $json.current_price }}, CURDATE());",
        "options": {}
      },
      "name": "MariaDB: Insert Today",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.2,
      "position": [
